@using AcxiomCRM.Models.Constants
@{
    ViewData["Title"] = "CRM Overview";
}

<div class="row mb-4">
    <div class="col-12">
        <div class="card bg-white shadow-sm border-0 p-4 rounded-3">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                    <h2 class="fw-bold mb-1">
                        Welcome back, <span class="text-primary">@User.Identity?.Name</span>!
                    </h2>
                    <p class="text-muted mb-0">AcxiomCRM Enterprise Customer Relationship Management System</p>
                </div>
                <div>
                    @if (User.IsInRole(AppRoles.Admin))
                    {
                        <span class="badge bg-danger fs-6 px-3 py-2"><i class="bi bi-shield-shaded me-1"></i> Role: Administrator</span>
                    }
                    else if (User.IsInRole(AppRoles.Manager))
                    {
                        <span class="badge bg-primary fs-6 px-3 py-2"><i class="bi bi-people-fill me-1"></i> Role: Sales Manager</span>
                    }
                    else if (User.IsInRole(AppRoles.SalesExecutive))
                    {
                        <span class="badge bg-info text-dark fs-6 px-3 py-2"><i class="bi bi-person-badge-fill me-1"></i> Role: Sales Executive</span>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-6 col-lg-3">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="text-muted fw-semibold">Customers</span>
                    <span class="bg-primary-subtle text-primary p-2 rounded-circle"><i class="bi bi-building fs-5"></i></span>
                </div>
                <h5 class="fw-bold mb-1">Customer Accounts</h5>
                <p class="text-muted small mb-3">Manage corporate and contact profiles.</p>
                <a asp-controller="Customers" asp-action="Index" class="btn btn-sm btn-outline-primary w-100">View Customers</a>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-lg-3">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="text-muted fw-semibold">Leads</span>
                    <span class="bg-success-subtle text-success p-2 rounded-circle"><i class="bi bi-funnel fs-5"></i></span>
                </div>
                <h5 class="fw-bold mb-1">Lead Pipeline</h5>
                <p class="text-muted small mb-3">Track inquiries and qualification lifecycle.</p>
                <a asp-controller="Leads" asp-action="Index" class="btn btn-sm btn-outline-success w-100">View Leads</a>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-lg-3">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="text-muted fw-semibold">Opportunities</span>
                    <span class="bg-warning-subtle text-warning p-2 rounded-circle"><i class="bi bi-graph-up-arrow fs-5"></i></span>
                </div>
                <h5 class="fw-bold mb-1">Deals & Opportunities</h5>
                <p class="text-muted small mb-3">Manage deal stages, amounts and close dates.</p>
                <a asp-controller="Opportunities" asp-action="Index" class="btn btn-sm btn-outline-warning w-100">View Deals</a>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-lg-3">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="text-muted fw-semibold">Follow-Ups</span>
                    <span class="bg-info-subtle text-info p-2 rounded-circle"><i class="bi bi-calendar-check fs-5"></i></span>
                </div>
                <h5 class="fw-bold mb-1">Scheduled Follow-Ups</h5>
                <p class="text-muted small mb-3">Planned customer touchpoints and meetings.</p>
                <a asp-controller="FollowUps" asp-action="Index" class="btn btn-sm btn-outline-info w-100">View Schedule</a>
            </div>
        </div>
    </div>
</div>

@if (User.IsInRole(AppRoles.Admin))
{
    <div class="row mt-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm bg-light">
                <div class="card-body d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div>
                        <h6 class="fw-bold mb-1"><i class="bi bi-shield-lock me-1"></i> Administrator Quick Actions</h6>
                        <small class="text-muted">Manage system users, role authorizations, lockout status, and security audit logs.</small>
                    </div>
                    <div class="d-flex gap-2">
                        <a asp-controller="Users" asp-action="Index" class="btn btn-sm btn-dark">
                            <i class="bi bi-people me-1"></i> User Management
                        </a>
                        <a href="/swagger" target="_blank" class="btn btn-sm btn-outline-secondary">
                            <i class="bi bi-code-slash me-1"></i> API Docs
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
