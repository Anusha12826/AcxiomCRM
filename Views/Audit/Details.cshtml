@model AcxiomCRM.Models.AuditLog
@{
    ViewData["Title"] = $"Audit Event #{Model.AuditLogId}";
}

<div class="row justify-content-center mt-3">
    <div class="col-lg-9">
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-header bg-dark text-white py-3 rounded-top d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-shield-check me-2"></i>Audit Log Record #@Model.AuditLogId</h5>
                    <span class="badge bg-primary">@Model.Action</span>
                    @if (Model.Result == "Success")
                    {
                        <span class="badge bg-success">Success</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">@(Model.Result ?? "Failed")</span>
                    }
                </div>
                <a asp-action="Index" class="btn btn-outline-light btn-sm">
                    <i class="bi bi-arrow-left me-1"></i> Back to Audit Trail
                </a>
            </div>
            <div class="card-body p-4">
                <!-- Event Metadata -->
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded border h-100">
                            <h6 class="fw-bold text-primary mb-3"><i class="bi bi-person-circle me-1"></i>Actor / User Context</h6>
                            <ul class="list-unstyled small mb-0">
                                <li class="mb-2"><strong>User Name:</strong> @(Model.User?.FullName ?? "System / Anonymous")</li>
                                <li class="mb-2"><strong>Email Address:</strong> @(Model.User?.Email ?? "-")</li>
                                <li class="mb-2"><strong>User ID:</strong> <code class="text-muted">@(Model.UserId ?? "-")</code></li>
                                <li><strong>Client IP Address:</strong> <code>@(Model.IpAddress ?? "127.0.0.1")</code></li>
                            </ul>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded border h-100">
                            <h6 class="fw-bold text-primary mb-3"><i class="bi bi-bullseye me-1"></i>Target Entity Details</h6>
                            <ul class="list-unstyled small mb-0">
                                <li class="mb-2"><strong>Entity / Module:</strong> <span class="badge bg-light text-dark border">@(Model.EntityName ?? "System")</span></li>
                                <li class="mb-2"><strong>Record ID:</strong> <code>@(Model.RecordId ?? "-")</code></li>
                                <li class="mb-2"><strong>Action:</strong> <span class="badge bg-dark">@Model.Action</span></li>
                                <li><strong>Timestamp:</strong> @Model.CreatedDate.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss") (Local) / @Model.CreatedDate.ToString("yyyy-MM-dd HH:mm:ss") (UTC)</li>
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- Event Details & Summary -->
                @if (!string.IsNullOrEmpty(Model.Details))
                {
                    <div class="mb-4">
                        <h6 class="fw-bold mb-2"><i class="bi bi-chat-left-text me-1"></i>Event Summary & Details</h6>
                        <div class="p-3 bg-light rounded border small">@Model.Details</div>
                    </div>
                }

                <!-- Old Value vs New Value Diff -->
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="card border">
                            <div class="card-header bg-light py-2 small fw-bold text-danger">
                                <i class="bi bi-dash-circle me-1"></i> Pre-Change State (Old Value)
                            </div>
                            <div class="card-body p-3 font-monospace small" style="min-height: 120px; white-space: pre-wrap; word-break: break-all;">
                                @(string.IsNullOrEmpty(Model.OldValue) ? "[None / Initial State]" : Model.OldValue)
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="card border">
                            <div class="card-header bg-light py-2 small fw-bold text-success">
                                <i class="bi bi-plus-circle me-1"></i> Post-Change State (New Value)
                            </div>
                            <div class="card-body p-3 font-monospace small" style="min-height: 120px; white-space: pre-wrap; word-break: break-all;">
                                @(string.IsNullOrEmpty(Model.NewValue) ? "[None / Deleted Record]" : Model.NewValue)
                            </div>
                        </div>
                    </div>
                </div>

                <div class="mt-4 pt-3 border-top text-end">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-arrow-left me-1"></i> Back to Audit Log List
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
