@model AcxiomCRM.ViewModels.ActivityListViewModel
@using AcxiomCRM.Models.Constants
@{
    ViewData["Title"] = "Activity Management";
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-clock-history text-primary me-2"></i>Activity Management</h2>
        <p class="text-muted mb-0">Log and track client interactions: phone calls, scheduled meetings, emails, and action tasks.</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary fw-semibold">
            <i class="bi bi-plus-circle me-1"></i> Log Activity
        </a>
    </div>
</div>

<!-- Activity Type Metric Cards -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card shadow-sm border-0 border-start border-primary border-4 h-100">
            <div class="card-body py-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Calls</div>
                        <div class="fs-4 fw-bold text-primary mt-1">@Model.CallCount</div>
                    </div>
                    <i class="bi bi-telephone fs-2 text-primary opacity-50"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card shadow-sm border-0 border-start border-success border-4 h-100">
            <div class="card-body py-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Meetings</div>
                        <div class="fs-4 fw-bold text-success mt-1">@Model.MeetingCount</div>
                    </div>
                    <i class="bi bi-people fs-2 text-success opacity-50"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card shadow-sm border-0 border-start border-info border-4 h-100">
            <div class="card-body py-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Emails</div>
                        <div class="fs-4 fw-bold text-info mt-1">@Model.EmailCount</div>
                    </div>
                    <i class="bi bi-envelope fs-2 text-info opacity-50"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card shadow-sm border-0 border-start border-warning border-4 h-100">
            <div class="card-body py-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Tasks</div>
                        <div class="fs-4 fw-bold text-warning mt-1">@Model.TaskCount</div>
                    </div>
                    <i class="bi bi-check2-square fs-2 text-warning opacity-50"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Search & Filters -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-3">
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" class="form-control" placeholder="Search subject, description, client..." value="@Model.SearchTerm" />
                </div>
            </div>
            <div class="col-md-2">
                <select name="type" class="form-select">
                    <option value="">-- All Types --</option>
                    @foreach (var t in ActivityTypes.AllTypes)
                    {
                        <option value="@t" selected="@(Model.TypeFilter == t)">@t</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <select name="status" class="form-select">
                    <option value="">-- Status --</option>
                    @foreach (var s in ActivityStatuses.AllStatuses)
                    {
                        <option value="@s" selected="@(Model.StatusFilter == s)">@s</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <select name="assignedTo" class="form-select">
                    <option value="">-- All Executives --</option>
                    @foreach (var exec in Model.SalesExecutives)
                    {
                        <option value="@exec.Key" selected="@(Model.AssignedToFilter == exec.Key)">@exec.Value</option>
                    }
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-outline-primary w-100">Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- Activities Table -->
<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Type</th>
                    <th>Subject & Details</th>
                    <th>Linked Account / Lead</th>
                    <th>Activity Date</th>
                    <th>Status</th>
                    <th>Owner</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Activities.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">
                            <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                            No activity records found matching your filters.
                        </td>
                    </tr>
                }
                @foreach (var act in Model.Activities)
                {
                    <tr>
                        <td>
                            @switch (act.ActivityType)
                            {
                                case "Call":
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle"><i class="bi bi-telephone me-1"></i>Call</span>
                                    break;
                                case "Meeting":
                                    <span class="badge bg-success-subtle text-success border border-success-subtle"><i class="bi bi-people me-1"></i>Meeting</span>
                                    break;
                                case "Email":
                                    <span class="badge bg-info-subtle text-info border border-info-subtle"><i class="bi bi-envelope me-1"></i>Email</span>
                                    break;
                                case "Task":
                                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle"><i class="bi bi-check2-square me-1"></i>Task</span>
                                    break;
                                default:
                                    <span class="badge bg-secondary">@act.ActivityType</span>
                                    break;
                            }
                        </td>
                        <td>
                            <div class="fw-bold">
                                <a asp-action="Details" asp-route-id="@act.ActivityId" class="text-decoration-none">
                                    @act.Subject
                                </a>
                            </div>
                            <div class="small text-muted text-truncate" style="max-width: 320px;" title="@act.Description">
                                @(act.Description ?? "-")
                            </div>
                        </td>
                        <td>
                            @if (act.Customer != null)
                            {
                                <div>
                                    <a asp-controller="Customers" asp-action="Details" asp-route-id="@act.CustomerId" class="text-decoration-none text-primary">
                                        <i class="bi bi-building me-1"></i>@act.Customer.CustomerName
                                    </a>
                                </div>
                                <div class="small text-muted font-monospace">@act.Customer.CustomerCode</div>
                            }
                            else if (act.Lead != null)
                            {
                                <div>
                                    <a asp-controller="Leads" asp-action="Details" asp-route-id="@act.LeadId" class="text-decoration-none text-info">
                                        <i class="bi bi-funnel me-1"></i>@act.Lead.LeadName
                                    </a>
                                </div>
                                <div class="small text-muted font-monospace">@act.Lead.LeadCode</div>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                        <td class="small">
                            <div>@act.ActivityDate.ToLocalTime().ToString("MMM dd, yyyy")</div>
                            <div class="text-muted">@act.ActivityDate.ToLocalTime().ToString("hh:mm tt")</div>
                        </td>
                        <td>
                            @switch (act.Status)
                            {
                                case "Completed":
                                    <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Completed</span>
                                    break;
                                case "Pending":
                                    <span class="badge bg-warning text-dark"><i class="bi bi-hourglass-split me-1"></i>Pending</span>
                                    break;
                                case "Cancelled":
                                    <span class="badge bg-secondary"><i class="bi bi-x-circle me-1"></i>Cancelled</span>
                                    break;
                                default:
                                    <span class="badge bg-secondary">@act.Status</span>
                                    break;
                            }
                        </td>
                        <td>
                            <span class="badge bg-secondary-subtle text-secondary small">
                                <i class="bi bi-person me-1"></i>@(act.AssignedUser?.FullName ?? act.AssignedUser?.Email ?? "Unassigned")
                            </span>
                        </td>
                        <td class="text-end">
                            <div class="btn-group">
                                <a asp-action="Details" asp-route-id="@act.ActivityId" class="btn btn-sm btn-outline-info" title="View Details">
                                    <i class="bi bi-eye"></i>
                                </a>
                                @if (act.Status == "Pending")
                                {
                                    <form asp-action="UpdateStatus" asp-route-id="@act.ActivityId" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="newStatus" value="Completed" />
                                        <button type="submit" class="btn btn-sm btn-outline-success" title="Mark Completed">
                                            <i class="bi bi-check-lg"></i>
                                        </button>
                                    </form>
                                }
                                <a asp-action="Edit" asp-route-id="@act.ActivityId" class="btn btn-sm btn-outline-primary" title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                @if (User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.Manager))
                                {
                                    <form asp-action="Delete" asp-route-id="@act.ActivityId" method="post" class="d-inline" onsubmit="return confirm('Delete this activity record?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3">
            <span class="small text-muted">
                Showing page <strong>@Model.PageIndex</strong> of <strong>@Model.TotalPages</strong> (Total: @Model.TotalCount activities)
            </span>
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                        <a class="page-link" asp-action="Index"
                           asp-route-page="@(Model.PageIndex - 1)"
                           asp-route-search="@Model.SearchTerm"
                           asp-route-type="@Model.TypeFilter"
                           asp-route-status="@Model.StatusFilter"
                           asp-route-assignedTo="@Model.AssignedToFilter">Previous</a>
                    </li>
                    @for (int p = 1; p <= Model.TotalPages; p++)
                    {
                        <li class="page-item @(p == Model.PageIndex ? "active" : "")">
                            <a class="page-link" asp-action="Index"
                               asp-route-page="@p"
                               asp-route-search="@Model.SearchTerm"
                               asp-route-type="@Model.TypeFilter"
                               asp-route-status="@Model.StatusFilter"
                               asp-route-assignedTo="@Model.AssignedToFilter">@p</a>
                        </li>
                    }
                    <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                        <a class="page-link" asp-action="Index"
                           asp-route-page="@(Model.PageIndex + 1)"
                           asp-route-search="@Model.SearchTerm"
                           asp-route-type="@Model.TypeFilter"
                           asp-route-status="@Model.StatusFilter"
                           asp-route-assignedTo="@Model.AssignedToFilter">Next</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>
