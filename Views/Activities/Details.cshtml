@model AcxiomCRM.Models.Activity
@using AcxiomCRM.Models.Constants
@{
    ViewData["Title"] = $"Activity - {Model.Subject}";
}

<div class="row justify-content-center mt-3">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0 mb-4 rounded-3">
            <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div class="d-flex align-items-center gap-2">
                    <h4 class="fw-bold mb-0">@Model.Subject</h4>
                    @switch (Model.ActivityType)
                    {
                        case "Call":
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle"><i class="bi bi-telephone me-1"></i>Call</span>
                            break;
                        case "Meeting":
                            <span class="badge bg-success-subtle text-success border border-success-subtle"><i class="bi bi-people me-1"></i>Meeting</span>
                            break;
                        case "Email":
                            <span class="badge bg-info-subtle text-info border border-info-subtle"><i class="bi bi-envelope me-1"></i>Email</span>
                            break;
                        case "Task":
                            <span class="badge bg-warning-subtle text-warning border border-warning-subtle"><i class="bi bi-check2-square me-1"></i>Task</span>
                            break;
                        default:
                            <span class="badge bg-secondary">@Model.ActivityType</span>
                            break;
                    }
                    @switch (Model.Status)
                    {
                        case "Completed":
                            <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Completed</span>
                            break;
                        case "Pending":
                            <span class="badge bg-warning text-dark"><i class="bi bi-hourglass-split me-1"></i>Pending</span>
                            break;
                        case "Cancelled":
                            <span class="badge bg-secondary"><i class="bi bi-x-circle me-1"></i>Cancelled</span>
                            break;
                        default:
                            <span class="badge bg-secondary">@Model.Status</span>
                            break;
                    }
                </div>
                <div class="d-flex gap-2">
                    <a asp-action="Edit" asp-route-id="@Model.ActivityId" class="btn btn-outline-primary btn-sm">
                        <i class="bi bi-pencil me-1"></i> Edit
                    </a>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-arrow-left me-1"></i> Back to Activities
                    </a>
                </div>
            </div>
            <div class="card-body p-4 pt-0">
                <!-- Target Information Card -->
                <div class="alert alert-light border p-3 mb-4 rounded">
                    <h6 class="fw-bold text-primary mb-2"><i class="bi bi-bullseye me-1"></i>Target Account / Lead</h6>
                    @if (Model.Customer != null)
                    {
                        <div>
                            <strong>Customer Account:</strong>
                            <a asp-controller="Customers" asp-action="Details" asp-route-id="@Model.CustomerId" class="fw-bold text-decoration-none">
                                @Model.Customer.CustomerName (@Model.Customer.CustomerCode)
                            </a>
                        </div>
                        <div class="small text-muted">
                            <i class="bi bi-envelope me-1"></i>@Model.Customer.Email &bull; <i class="bi bi-telephone me-1"></i>@Model.Customer.Phone
                        </div>
                    }
                    else if (Model.Lead != null)
                    {
                        <div>
                            <strong>Lead Prospect:</strong>
                            <a asp-controller="Leads" asp-action="Details" asp-route-id="@Model.LeadId" class="fw-bold text-decoration-none">
                                @Model.Lead.LeadName (@Model.Lead.LeadCode)
                            </a>
                        </div>
                        <div class="small text-muted">
                            <i class="bi bi-envelope me-1"></i>@Model.Lead.Email &bull; <i class="bi bi-telephone me-1"></i>@Model.Lead.Phone
                        </div>
                    }
                </div>

                <!-- Schedule Details -->
                <div class="row g-3 mb-4">
                    <div class="col-sm-6">
                        <span class="text-muted small d-block">Activity Date & Time</span>
                        <strong class="fs-6">@Model.ActivityDate.ToLocalTime().ToString("dddd, MMMM dd, yyyy")</strong>
                        <div class="text-muted small">@Model.ActivityDate.ToLocalTime().ToString("hh:mm tt")</div>
                    </div>
                    <div class="col-sm-6">
                        <span class="text-muted small d-block">Assigned Representative</span>
                        <strong>@(Model.AssignedUser?.FullName ?? Model.AssignedUser?.Email ?? "Unassigned")</strong>
                    </div>
                    <div class="col-sm-6">
                        <span class="text-muted small d-block">Activity Status</span>
                        <span>@Model.Status</span>
                    </div>
                    <div class="col-sm-6">
                        <span class="text-muted small d-block">Logged Timestamp</span>
                        <span>@Model.CreatedDate.ToLocalTime().ToString("MMM dd, yyyy HH:mm")</span>
                    </div>
                </div>

                <!-- Description / Meeting Notes -->
                <div class="mb-4">
                    <h6 class="fw-bold mb-2"><i class="bi bi-card-text me-1"></i>Description & Outcome Summary</h6>
                    <div class="p-3 bg-light rounded border font-monospace small" style="white-space: pre-wrap;">@(Model.Description ?? "No description or notes provided.")</div>
                </div>

                @if (Model.Status == "Pending")
                {
                    <hr class="my-4" />
                    <form asp-action="UpdateStatus" asp-route-id="@Model.ActivityId" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="newStatus" value="Completed" />
                        <button type="submit" class="btn btn-success fw-semibold">
                            <i class="bi bi-check-circle me-1"></i> Mark Activity as Completed
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>
