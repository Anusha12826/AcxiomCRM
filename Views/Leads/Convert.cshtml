@model AcxiomCRM.ViewModels.LeadConvertViewModel
@using AcxiomCRM.Models.Constants
@{
    ViewData["Title"] = $"Convert Lead - {Model.CustomerName}";
    var salesExecutives = ViewBag.SalesExecutives as Dictionary<string, string> ?? new();
}

<div class="row justify-content-center mt-3">
    <div class="col-lg-9">
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-header bg-success text-white py-3 rounded-top">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <h5 class="mb-0 fw-bold"><i class="bi bi-arrow-repeat me-2"></i>Lead Conversion Workflow</h5>
                        <small class="text-white-50">Convert prospective lead into active Customer Account and Sales Opportunity</small>
                    </div>
                    <span class="badge bg-light text-dark font-monospace">@Model.LeadCode</span>
                </div>
            </div>
            <div class="card-body p-4">
                <form asp-action="Convert" method="post" id="convertForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="LeadId" />
                    <input type="hidden" asp-for="LeadCode" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <!-- Step 1: Customer Account Creation -->
                    <div class="border rounded p-3 mb-4 bg-light">
                        <h6 class="fw-bold text-primary mb-3">
                            <i class="bi bi-person-badge-fill me-1"></i> Step 1: Client Account Information
                        </h6>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="CustomerName" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                                <input asp-for="CustomerName" class="form-control" />
                                <span asp-validation-for="CustomerName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="CompanyName" class="form-label fw-semibold"></label>
                                <input asp-for="CompanyName" class="form-control" />
                                <span asp-validation-for="CompanyName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                                <input asp-for="Email" class="form-control" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Phone" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                                <input asp-for="Phone" class="form-control" />
                                <span asp-validation-for="Phone" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="Address" class="form-label fw-semibold"></label>
                                <input asp-for="Address" class="form-control" placeholder="Street Address" />
                                <span asp-validation-for="Address" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="City" class="form-label fw-semibold"></label>
                                <input asp-for="City" class="form-control" />
                                <span asp-validation-for="City" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="State" class="form-label fw-semibold"></label>
                                <input asp-for="State" class="form-control" />
                                <span asp-validation-for="State" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Step 2: Opportunity Deal Creation -->
                    <div class="border rounded p-3 mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h6 class="fw-bold text-success mb-0">
                                <i class="bi bi-briefcase-fill me-1"></i> Step 2: Opportunity / Deal Creation
                            </h6>
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" asp-for="CreateOpportunity" id="toggleOpp" />
                                <label class="form-check-label fw-semibold small" for="toggleOpp">Generate Deal</label>
                            </div>
                        </div>

                        <div id="oppSection" class="row g-3">
                            <div class="col-md-8">
                                <label asp-for="OpportunityName" class="form-label fw-semibold"></label>
                                <input asp-for="OpportunityName" class="form-control" placeholder="e.g. Enterprise License Contract" />
                                <span asp-validation-for="OpportunityName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="OpportunityAmount" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                                <div class="input-group">
                                    <span class="input-group-text">₹</span>
                                    <input asp-for="OpportunityAmount" class="form-control" type="number" step="0.01" min="1" />
                                </div>
                                <span asp-validation-for="OpportunityAmount" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="OpportunityStage" class="form-label fw-semibold"></label>
                                <select asp-for="OpportunityStage" class="form-select">
                                    @foreach (var stage in OpportunityStages.AllStages)
                                    {
                                        <option value="@stage" selected="@(Model.OpportunityStage == stage)">@stage</option>
                                    }
                                </select>
                                <span asp-validation-for="OpportunityStage" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Probability" class="form-label fw-semibold"></label>
                                <div class="input-group">
                                    <input asp-for="Probability" class="form-control" type="number" min="0" max="100" />
                                    <span class="input-group-text">%</span>
                                </div>
                                <span asp-validation-for="Probability" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="ExpectedCloseDate" class="form-label fw-semibold"></label>
                                <input asp-for="ExpectedCloseDate" class="form-control" type="date" value="@Model.ExpectedCloseDate.ToString("yyyy-MM-dd")" />
                                <span asp-validation-for="ExpectedCloseDate" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Step 3: Owner Assignment -->
                    <div class="mb-4">
                        <label asp-for="AssignedTo" class="form-label fw-semibold"></label>
                        <select asp-for="AssignedTo" class="form-select">
                            <option value="">-- Assign to Current User / Default --</option>
                            @foreach (var exec in salesExecutives)
                            {
                                <option value="@exec.Key" selected="@(Model.AssignedTo == exec.Key)">@exec.Value</option>
                            }
                        </select>
                        <span asp-validation-for="AssignedTo" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                        <a asp-action="Details" asp-route-id="@Model.LeadId" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i> Cancel
                        </a>
                        <button type="submit" class="btn btn-success fw-bold px-4 py-2">
                            <i class="bi bi-check2-circle me-1"></i> Execute Conversion
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('toggleOpp').addEventListener('change', function () {
            var oppSection = document.getElementById('oppSection');
            if (this.checked) {
                oppSection.style.display = 'flex';
            } else {
                oppSection.style.display = 'none';
            }
        });
    </script>
}
