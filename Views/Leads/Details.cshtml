@model AcxiomCRM.ViewModels.LeadDetailsViewModel
@using AcxiomCRM.Models.Constants
@{
    ViewData["Title"] = $"Lead - {Model.Lead.LeadName}";
}

<!-- Profile Header -->
<div class="card shadow-sm border-0 mb-4 rounded-3">
    <div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <h3 class="fw-bold mb-0">@Model.Lead.LeadName</h3>
                    <span class="badge bg-light text-dark border font-monospace">@Model.Lead.LeadCode</span>
                    @switch (Model.Lead.Status)
                    {
                        case "New":
                            <span class="badge bg-primary fs-6">New</span>
                            break;
                        case "Contacted":
                            <span class="badge bg-info text-dark fs-6">Contacted</span>
                            break;
                        case "Qualified":
                            <span class="badge bg-success fs-6">Qualified</span>
                            break;
                        case "Converted":
                            <span class="badge bg-dark fs-6"><i class="bi bi-check-all me-1"></i>Converted</span>
                            break;
                        case "Lost":
                            <span class="badge bg-danger fs-6">Lost</span>
                            break;
                        default:
                            <span class="badge bg-secondary fs-6">@Model.Lead.Status</span>
                            break;
                    }
                    <span class="badge bg-warning text-dark">Priority: @(Model.Lead.Priority ?? "Medium")</span>
                </div>
                <div class="text-muted">
                    <i class="bi bi-building me-1"></i>@(Model.Lead.CompanyName ?? "Prospect") · <i class="bi bi-compass me-1"></i>Source: @Model.Lead.Source
                </div>
            </div>
            <div class="d-flex gap-2 align-items-center flex-wrap">
                @if (Model.Lead.Status != LeadStatuses.Converted)
                {
                    <a asp-action="Convert" asp-route-id="@Model.Lead.LeadId" class="btn btn-success fw-semibold">
                        <i class="bi bi-arrow-repeat me-1"></i> Convert Lead
                    </a>
                }
                <a asp-action="Edit" asp-route-id="@Model.Lead.LeadId" class="btn btn-outline-primary">
                    <i class="bi bi-pencil me-1"></i> Edit
                </a>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Back to Leads
                </a>
            </div>
        </div>

        @if (Model.Lead.Status == LeadStatuses.Converted)
        {
            <div class="alert alert-success d-flex align-items-center mt-3 mb-0">
                <i class="bi bi-check-circle-fill fs-4 me-2"></i>
                <div>
                    <strong>Lead Successfully Converted!</strong>
                    @if (Model.Lead.ConvertedCustomerId.HasValue)
                    {
                        <span class="ms-2">Linked Customer: <a asp-controller="Customers" asp-action="Details" asp-route-id="@Model.Lead.ConvertedCustomerId.Value" class="alert-link fw-bold">View Customer #@Model.Lead.ConvertedCustomerId</a></span>
                    }
                    @if (Model.Lead.ConvertedOpportunityId.HasValue)
                    {
                        <span class="ms-2">· Linked Deal: <span class="badge bg-success-subtle text-success">Deal #@Model.Lead.ConvertedOpportunityId</span></span>
                    }
                </div>
            </div>
        }
        else
        {
            <!-- Quick Workflow Transition Bar -->
            <div class="mt-3 pt-3 border-top d-flex align-items-center gap-2 flex-wrap">
                <span class="small fw-bold text-muted me-2"><i class="bi bi-diagram-3 me-1"></i>Workflow Pipeline:</span>
                
                @if (Model.Lead.Status == LeadStatuses.New)
                {
                    <form asp-action="UpdateStatus" asp-route-id="@Model.Lead.LeadId" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="newStatus" value="Contacted" />
                        <button type="submit" class="btn btn-sm btn-outline-info">
                            <i class="bi bi-telephone-outbound me-1"></i> Mark as Contacted
                        </button>
                    </form>
                }
                @if (Model.Lead.Status == LeadStatuses.Contacted)
                {
                    <form asp-action="UpdateStatus" asp-route-id="@Model.Lead.LeadId" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="newStatus" value="Qualified" />
                        <button type="submit" class="btn btn-sm btn-outline-success">
                            <i class="bi bi-check-lg me-1"></i> Mark as Qualified
                        </button>
                    </form>
                    <form asp-action="UpdateStatus" asp-route-id="@Model.Lead.LeadId" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="newStatus" value="Unqualified" />
                        <button type="submit" class="btn btn-sm btn-outline-secondary">
                            <i class="bi bi-x-circle me-1"></i> Mark as Unqualified
                        </button>
                    </form>
                }
                @if (Model.Lead.Status == LeadStatuses.Qualified)
                {
                    <a asp-action="Convert" asp-route-id="@Model.Lead.LeadId" class="btn btn-sm btn-success fw-bold">
                        <i class="bi bi-arrow-repeat me-1"></i> Convert to Customer & Opportunity
                    </a>
                    <form asp-action="UpdateStatus" asp-route-id="@Model.Lead.LeadId" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="newStatus" value="Lost" />
                        <button type="submit" class="btn btn-sm btn-outline-danger">
                            <i class="bi bi-hand-thumbs-down me-1"></i> Mark as Lost
                        </button>
                    </form>
                }
                @if (Model.Lead.Status == LeadStatuses.Lost || Model.Lead.Status == LeadStatuses.Unqualified)
                {
                    <form asp-action="UpdateStatus" asp-route-id="@Model.Lead.LeadId" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="newStatus" value="New" />
                        <button type="submit" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-arrow-counterclockwise me-1"></i> Re-open as New
                        </button>
                    </form>
                }
            </div>
        }
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Lead Profile Details -->
    <div class="col-lg-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white py-3 border-0">
                <h6 class="fw-bold mb-0"><i class="bi bi-info-circle text-primary me-2"></i>Lead Information</h6>
            </div>
            <div class="card-body pt-0">
                <ul class="list-group list-group-flush small">
                    <li class="list-group-item px-0 d-flex justify-content-between">
                        <span class="text-muted">Email</span>
                        <span class="fw-semibold"><a href="mailto:@Model.Lead.Email" class="text-decoration-none">@Model.Lead.Email</a></span>
                    </li>
                    <li class="list-group-item px-0 d-flex justify-content-between">
                        <span class="text-muted">Phone</span>
                        <span class="fw-semibold">@Model.Lead.Phone</span>
                    </li>
                    <li class="list-group-item px-0 d-flex justify-content-between">
                        <span class="text-muted">Company</span>
                        <span class="fw-semibold">@(Model.Lead.CompanyName ?? "-")</span>
                    </li>
                    <li class="list-group-item px-0 d-flex justify-content-between">
                        <span class="text-muted">Lead Source</span>
                        <span class="badge bg-light text-dark border">@Model.Lead.Source</span>
                    </li>
                    <li class="list-group-item px-0 d-flex justify-content-between">
                        <span class="text-muted">Expected Value</span>
                        <span class="fw-bold text-success fs-6">₹@Model.Lead.ExpectedValue.ToString("N0")</span>
                    </li>
                    <li class="list-group-item px-0 d-flex justify-content-between">
                        <span class="text-muted">Priority</span>
                        <span>@Model.Lead.Priority</span>
                    </li>
                    <li class="list-group-item px-0 d-flex justify-content-between">
                        <span class="text-muted">Assigned To</span>
                        <span class="badge bg-secondary-subtle text-secondary">
                            @(Model.Lead.AssignedUser?.FullName ?? Model.Lead.AssignedUser?.Email ?? "Unassigned")
                        </span>
                    </li>
                    <li class="list-group-item px-0 d-flex justify-content-between">
                        <span class="text-muted">Created Date</span>
                        <span>@Model.Lead.CreatedDate.ToLocalTime().ToString("MMM dd, yyyy")</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <!-- Related Operations & History -->
    <div class="col-lg-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white border-0 pt-3">
                <ul class="nav nav-tabs card-header-tabs" id="leadTabs" role="tablist">
                    <li class="nav-item">
                        <button class="nav-link active fw-semibold" id="opps-tab" data-bs-toggle="tab" data-bs-target="#opps" type="button" role="tab">
                            <i class="bi bi-briefcase me-1"></i> Opportunities (@Model.Opportunities.Count)
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link fw-semibold" id="followups-tab" data-bs-toggle="tab" data-bs-target="#followups" type="button" role="tab">
                            <i class="bi bi-calendar-check me-1"></i> Follow-Ups (@Model.FollowUps.Count)
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link fw-semibold" id="activities-tab" data-bs-toggle="tab" data-bs-target="#activities" type="button" role="tab">
                            <i class="bi bi-clock-history me-1"></i> Activities (@Model.Activities.Count)
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link fw-semibold" id="audit-tab" data-bs-toggle="tab" data-bs-target="#audit" type="button" role="tab">
                            <i class="bi bi-shield-check me-1"></i> Audit History (@Model.AuditHistory.Count)
                        </button>
                    </li>
                </ul>
            </div>
            <div class="card-body p-0">
                <div class="tab-content p-3" id="leadTabsContent">
                    <!-- Opportunities Tab -->
                    <div class="tab-pane fade show active" id="opps" role="tabpanel">
                        @if (!Model.Opportunities.Any())
                        {
                            <div class="text-center py-4 text-muted small">No deals linked to this lead yet.</div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-sm table-hover align-middle mb-0">
                                    <thead class="table-light small">
                                        <tr>
                                            <th>Deal Name</th>
                                            <th>Amount</th>
                                            <th>Stage</th>
                                            <th>Probability</th>
                                            <th>Close Date</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody class="small">
                                        @foreach (var opp in Model.Opportunities)
                                        {
                                            <tr>
                                                <td class="fw-semibold">@opp.OpportunityName</td>
                                                <td class="fw-bold text-success">₹@opp.Amount.ToString("N0")</td>
                                                <td><span class="badge bg-light text-dark border">@opp.Stage</span></td>
                                                <td>@opp.Probability%</td>
                                                <td>@opp.ExpectedCloseDate.ToString("MMM dd, yyyy")</td>
                                                <td><span class="badge bg-primary">@opp.Status</span></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>

                    <!-- Follow-Ups Tab -->
                    <div class="tab-pane fade" id="followups" role="tabpanel">
                        @if (!Model.FollowUps.Any())
                        {
                            <div class="text-center py-4 text-muted small">No follow-ups scheduled for this lead.</div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-sm table-hover align-middle mb-0">
                                    <thead class="table-light small">
                                        <tr>
                                            <th>Date</th>
                                            <th>Type</th>
                                            <th>Remarks</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody class="small">
                                        @foreach (var fu in Model.FollowUps)
                                        {
                                            <tr>
                                                <td>@fu.FollowUpDate.ToString("MMM dd, yyyy hh:mm tt")</td>
                                                <td><span class="badge bg-light text-dark border">@fu.FollowUpType</span></td>
                                                <td>@(fu.Remarks ?? "-")</td>
                                                <td><span class="badge bg-primary">@fu.Status</span></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>

                    <!-- Activities Tab -->
                    <div class="tab-pane fade" id="activities" role="tabpanel">
                        @if (!Model.Activities.Any())
                        {
                            <div class="text-center py-4 text-muted small">No activities logged for this lead.</div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-sm table-hover align-middle mb-0">
                                    <thead class="table-light small">
                                        <tr>
                                            <th>Type</th>
                                            <th>Subject</th>
                                            <th>Date</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody class="small">
                                        @foreach (var act in Model.Activities)
                                        {
                                            <tr>
                                                <td><span class="badge bg-light text-dark border">@act.ActivityType</span></td>
                                                <td class="fw-semibold">@act.Subject</td>
                                                <td>@act.ActivityDate.ToString("MMM dd, yyyy")</td>
                                                <td><span class="badge bg-success">@act.Status</span></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>

                    <!-- Audit History Tab -->
                    <div class="tab-pane fade" id="audit" role="tabpanel">
                        @if (!Model.AuditHistory.Any())
                        {
                            <div class="text-center py-4 text-muted small">No audit history found for this lead.</div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-sm table-hover align-middle mb-0">
                                    <thead class="table-light small">
                                        <tr>
                                            <th>Action</th>
                                            <th>Date</th>
                                            <th>Result</th>
                                            <th>Details</th>
                                        </tr>
                                    </thead>
                                    <tbody class="small">
                                        @foreach (var log in Model.AuditHistory)
                                        {
                                            <tr>
                                                <td><span class="badge bg-dark">@log.Action</span></td>
                                                <td>@log.CreatedDate.ToLocalTime().ToString("MMM dd, yyyy HH:mm")</td>
                                                <td><span class="badge bg-success">@log.Result</span></td>
                                                <td class="text-muted smaller">@(log.Details ?? log.NewValue ?? "-")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
