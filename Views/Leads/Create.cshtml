@model AcxiomCRM.ViewModels.LeadCreateViewModel
@{
    ViewData["Title"] = "Create New Lead";
    var salesExecutives = ViewBag.SalesExecutives as Dictionary<string, string> ?? new();
}

<div class="row justify-content-center mt-3">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-header bg-primary text-white py-3 rounded-top">
                <h5 class="mb-0 fw-bold"><i class="bi bi-funnel me-2"></i>Create New Sales Lead</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post" id="leadForm">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-md-4">
                            <label asp-for="LeadCode" class="form-label fw-semibold"></label>
                            <input asp-for="LeadCode" class="form-control" placeholder="e.g. LEAD-2005" />
                            <span asp-validation-for="LeadCode" class="text-danger small"></span>
                        </div>
                        <div class="col-md-8">
                            <label asp-for="LeadName" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                            <input asp-for="LeadName" class="form-control" placeholder="Prospect contact name" autofocus />
                            <span asp-validation-for="LeadName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                                <input asp-for="Email" class="form-control" placeholder="prospect@company.com" />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-telephone"></i></span>
                                <input asp-for="Phone" class="form-control" placeholder="+91 98000 00000" />
                            </div>
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CompanyName" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-building"></i></span>
                                <input asp-for="CompanyName" class="form-control" placeholder="Prospect organization" />
                            </div>
                            <span asp-validation-for="CompanyName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Source" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                            <select asp-for="Source" class="form-select">
                                <option value="Website">Website Inbound</option>
                                <option value="Referral">Client Referral</option>
                                <option value="Cold Call">Outreach / Cold Call</option>
                                <option value="Campaign">Marketing Campaign</option>
                                <option value="Partner">Channel Partner</option>
                                <option value="Social Media">LinkedIn / Social Media</option>
                                <option value="Event">Trade Show / Conference</option>
                                <option value="Other">Other</option>
                            </select>
                            <span asp-validation-for="Source" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ExpectedValue" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                            <div class="input-group">
                                <span class="input-group-text">₹</span>
                                <input asp-for="ExpectedValue" class="form-control" type="number" step="0.01" min="0" placeholder="0.00" />
                            </div>
                            <span asp-validation-for="ExpectedValue" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Priority" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                            <select asp-for="Priority" class="form-select">
                                <option value="Low">Low</option>
                                <option value="Medium">Medium</option>
                                <option value="High">High</option>
                                <option value="Urgent">Urgent</option>
                            </select>
                            <span asp-validation-for="Priority" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="AssignedTo" class="form-label fw-semibold"></label>
                            <select asp-for="AssignedTo" class="form-select">
                                <option value="">-- Assign to Myself / Default --</option>
                                @foreach (var exec in salesExecutives)
                                {
                                    <option value="@exec.Key">@exec.Value</option>
                                }
                            </select>
                            <span asp-validation-for="AssignedTo" class="text-danger small"></span>
                        </div>
                    </div>

                    <hr class="my-4" />

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i> Back to List
                        </a>
                        <button type="submit" class="btn btn-primary fw-semibold px-4">
                            <i class="bi bi-check-circle me-1"></i> Save Lead
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
