@model AcxiomCRM.ViewModels.GenericReportViewModel<AcxiomCRM.ViewModels.LeadReportItem>
@{
    ViewData["Title"] = "Lead Report";
}

<div class="container-fluid px-0">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="fw-bold text-dark mb-0"><i class="bi bi-funnel text-warning me-2"></i>Lead Report</h3>
            <span class="text-muted small">Total Records: <strong>@Model.TotalCount</strong></span>
        </div>
        <div>
            <a asp-action="ExportCsv" asp-route-reportType="Leads" 
               asp-route-FromDate="@Model.Filter.FromDate?.ToString("yyyy-MM-dd")"
               asp-route-ToDate="@Model.Filter.ToDate?.ToString("yyyy-MM-dd")"
               asp-route-Status="@Model.Filter.Status"
               asp-route-AssignedTo="@Model.Filter.AssignedTo"
               class="btn btn-outline-success btn-sm me-2">
                <i class="bi bi-file-earmark-spreadsheet me-1"></i> Export CSV
            </a>
            <button onclick="window.print()" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-printer me-1"></i> Print
            </button>
        </div>
    </div>

    <!-- Filter Card -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3">
            <form method="get" asp-action="Leads" class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label class="form-label small text-muted mb-1">From Date</label>
                    <input type="date" name="FromDate" value="@(Model.Filter.FromDate?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small text-muted mb-1">To Date</label>
                    <input type="date" name="ToDate" value="@(Model.Filter.ToDate?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
                </div>
                <div class="col-md-2">
                    <label class="form-label small text-muted mb-1">Status</label>
                    <select name="Status" class="form-select form-select-sm">
                        <option value="">All Statuses</option>
                        <option value="New" selected="@(Model.Filter.Status == "New")">New</option>
                        <option value="Contacted" selected="@(Model.Filter.Status == "Contacted")">Contacted</option>
                        <option value="Qualified" selected="@(Model.Filter.Status == "Qualified")">Qualified</option>
                        <option value="Unqualified" selected="@(Model.Filter.Status == "Unqualified")">Unqualified</option>
                        <option value="Converted" selected="@(Model.Filter.Status == "Converted")">Converted</option>
                        <option value="Lost" selected="@(Model.Filter.Status == "Lost")">Lost</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small text-muted mb-1">Owner</label>
                    <select name="AssignedTo" class="form-select form-select-sm">
                        <option value="">All Owners</option>
                        @foreach (var user in Model.AvailableUsers)
                        {
                            <option value="@user.Key" selected="@(Model.Filter.AssignedTo == user.Key)">@user.Value</option>
                        }
                    </select>
                </div>
                <div class="col-md-2 d-flex gap-1">
                    <button type="submit" class="btn btn-primary btn-sm flex-grow-1">Filter</button>
                    <a asp-action="Leads" class="btn btn-outline-secondary btn-sm">Reset</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Table -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Code</th>
                        <th>Lead Name</th>
                        <th>Email & Phone</th>
                        <th>Company</th>
                        <th>Source</th>
                        <th>Status</th>
                        <th>Expected Value</th>
                        <th>Lead Owner</th>
                        <th>Created</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items.Any())
                    {
                        foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="fw-bold">@item.LeadCode</td>
                                <td>@item.LeadName</td>
                                <td>
                                    <div>@item.Email</div>
                                    <small class="text-muted">@item.Phone</small>
                                </td>
                                <td>@(item.CompanyName ?? "-")</td>
                                <td><span class="badge bg-light text-dark border">@item.Source</span></td>
                                <td>
                                    @if (item.IsConverted)
                                    {
                                        <span class="badge bg-primary"><i class="bi bi-check-circle me-1"></i>Converted</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@item.Status</span>
                                    }
                                </td>
                                <td class="fw-bold text-success">@item.ExpectedValue.ToString("C0")</td>
                                <td>@item.OwnerName</td>
                                <td class="text-muted small">@item.CreatedDate.ToString("yyyy-MM-dd")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center py-4 text-muted">No lead records matching the filter criteria.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
