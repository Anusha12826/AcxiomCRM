@model AcxiomCRM.ViewModels.GenericReportViewModel<AcxiomCRM.ViewModels.FollowUpReportItem>
@{
    ViewData["Title"] = "Follow-Up Compliance Report";
}

<div class="container-fluid px-0">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="fw-bold text-dark mb-0"><i class="bi bi-calendar-check text-info me-2"></i>Follow-Up Compliance Report</h3>
            <span class="text-muted small">Total Activities: <strong>@Model.TotalCount</strong></span>
        </div>
        <div>
            <a asp-action="ExportCsv" asp-route-reportType="FollowUps" 
               asp-route-FromDate="@Model.Filter.FromDate?.ToString("yyyy-MM-dd")"
               asp-route-ToDate="@Model.Filter.ToDate?.ToString("yyyy-MM-dd")"
               asp-route-Status="@Model.Filter.Status"
               asp-route-AssignedTo="@Model.Filter.AssignedTo"
               class="btn btn-outline-success btn-sm me-2">
                <i class="bi bi-file-earmark-spreadsheet me-1"></i> Export CSV
            </a>
            <button onclick="window.print()" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-printer me-1"></i> Print
            </button>
        </div>
    </div>

    <!-- Filter Card -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3">
            <form method="get" asp-action="FollowUps" class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label class="form-label small text-muted mb-1">From Date</label>
                    <input type="date" name="FromDate" value="@(Model.Filter.FromDate?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small text-muted mb-1">To Date</label>
                    <input type="date" name="ToDate" value="@(Model.Filter.ToDate?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
                </div>
                <div class="col-md-2">
                    <label class="form-label small text-muted mb-1">Status</label>
                    <select name="Status" class="form-select form-select-sm">
                        <option value="">All Statuses</option>
                        <option value="Planned" selected="@(Model.Filter.Status == "Planned")">Planned</option>
                        <option value="Completed" selected="@(Model.Filter.Status == "Completed")">Completed</option>
                        <option value="Missed" selected="@(Model.Filter.Status == "Missed")">Missed</option>
                        <option value="Cancelled" selected="@(Model.Filter.Status == "Cancelled")">Cancelled</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small text-muted mb-1">Owner</label>
                    <select name="AssignedTo" class="form-select form-select-sm">
                        <option value="">All Owners</option>
                        @foreach (var user in Model.AvailableUsers)
                        {
                            <option value="@user.Key" selected="@(Model.Filter.AssignedTo == user.Key)">@user.Value</option>
                        }
                    </select>
                </div>
                <div class="col-md-2 d-flex gap-1">
                    <button type="submit" class="btn btn-primary btn-sm flex-grow-1">Filter</button>
                    <a asp-action="FollowUps" class="btn btn-outline-secondary btn-sm">Reset</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Table -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Related Entity</th>
                        <th>Type</th>
                        <th>Scheduled Date</th>
                        <th>Compliance / Status</th>
                        <th>Assigned Representative</th>
                        <th>Remarks</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items.Any())
                    {
                        foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>#@item.FollowUpId</td>
                                <td class="fw-semibold">@item.RelatedEntityName</td>
                                <td><span class="badge bg-light text-dark border">@item.FollowUpType</span></td>
                                <td>@item.FollowUpDate.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>
                                    @if (item.IsOverdue)
                                    {
                                        <span class="badge bg-danger"><i class="bi bi-exclamation-triangle me-1"></i>Overdue</span>
                                    }
                                    else if (item.Status == "Completed")
                                    {
                                        <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Completed</span>
                                    }
                                    else if (item.Status == "Cancelled")
                                    {
                                        <span class="badge bg-secondary">Cancelled</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-primary">Planned</span>
                                    }
                                </td>
                                <td>@item.OwnerName</td>
                                <td class="text-muted small">@(item.Remarks ?? "-")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">No follow-up records found for the selected criteria.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
