@model AcxiomCRM.ViewModels.ConversionReportViewModel
@{
    ViewData["Title"] = "Lead-to-Customer Conversion Report";
}

<div class="container-fluid px-0">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="fw-bold text-dark mb-0"><i class="bi bi-arrow-repeat text-danger me-2"></i>Sales & Conversion Performance</h3>
            <span class="text-muted small">Lead conversion velocity and won opportunity revenue realization</span>
        </div>
        <div>
            <button onclick="window.print()" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-printer me-1"></i> Print
            </button>
        </div>
    </div>

    <!-- Conversion KPI Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-3 p-3">
                <span class="text-muted small text-uppercase fw-bold">Conversion Rate</span>
                <div class="d-flex align-items-baseline mt-2">
                    <h2 class="fw-bold text-primary mb-0">@Model.LeadConversionRate%</h2>
                    <span class="ms-2 text-muted small">of total leads</span>
                </div>
                <div class="progress mt-2" style="height: 6px;">
                    <div class="progress-bar bg-primary" role="progressbar" style="width: @Model.LeadConversionRate%" aria-valuenow="@Model.LeadConversionRate" aria-valuemin="0" aria-valuemax="100"></div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-3 p-3">
                <span class="text-muted small text-uppercase fw-bold">Total Leads Captured</span>
                <div class="d-flex align-items-baseline mt-2">
                    <h2 class="fw-bold text-dark mb-0">@Model.TotalLeads</h2>
                    <span class="ms-2 badge bg-success-subtle text-success">@Model.ConvertedLeads Converted</span>
                </div>
                <div class="text-muted small mt-2">
                    <span>@Model.OpenLeads Open</span> &bull; <span>@Model.LostLeads Lost</span>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-3 p-3">
                <span class="text-muted small text-uppercase fw-bold">Opportunity Win/Loss</span>
                <div class="d-flex align-items-baseline mt-2">
                    <h2 class="fw-bold text-success mb-0">@Model.TotalWonOpportunities</h2>
                    <span class="ms-2 text-muted">Won vs <strong class="text-danger">@Model.TotalLostOpportunities</strong> Lost</span>
                </div>
                <div class="text-muted small mt-2">Closed opportunities outcome</div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-3 p-3">
                <span class="text-muted small text-uppercase fw-bold">Realized Won Revenue</span>
                <h2 class="fw-bold text-success mb-0 mt-2">@Model.TotalWonRevenue.ToString("C0")</h2>
                <div class="text-muted small mt-2">Total value of won opportunities</div>
            </div>
        </div>
    </div>

    <!-- Converted Leads Table -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-header bg-white py-3 border-0">
            <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-check2-circle me-2 text-success"></i>Successfully Converted Leads</h5>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Lead Code</th>
                        <th>Lead Name</th>
                        <th>Email</th>
                        <th>Company</th>
                        <th>Source</th>
                        <th>Expected Value</th>
                        <th>Converted Customer ID</th>
                        <th>Owner</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.RecentConvertedLeads.Any())
                    {
                        foreach (var lead in Model.RecentConvertedLeads)
                        {
                            <tr>
                                <td class="fw-bold">@lead.LeadCode</td>
                                <td>@lead.LeadName</td>
                                <td>@lead.Email</td>
                                <td>@(lead.CompanyName ?? "-")</td>
                                <td><span class="badge bg-light text-dark border">@lead.Source</span></td>
                                <td class="fw-bold text-success">@lead.ExpectedValue.ToString("C0")</td>
                                <td>
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                                        Cust #@lead.ConvertedCustomerId
                                    </span>
                                </td>
                                <td>@lead.OwnerName</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">No converted leads recorded yet.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
