@model AcxiomCRM.ViewModels.AuditReportViewModel
@{
    ViewData["Title"] = "Audit Compliance & Security Report";
}

<div class="container-fluid px-0">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="fw-bold text-dark mb-0"><i class="bi bi-shield-check text-dark me-2"></i>Audit Compliance & Security Report</h3>
            <span class="text-muted small">Immutable security logging and enterprise activity governance</span>
        </div>
        <div>
            <button onclick="window.print()" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-printer me-1"></i> Print
            </button>
        </div>
    </div>

    <!-- Summary KPI Badges -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-dark text-white">
                <span class="text-white-50 small text-uppercase fw-bold">Total Audit Events</span>
                <h3 class="fw-bold mb-0 mt-1">@Model.TotalEvents</h3>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-primary text-white">
                <span class="text-white-50 small text-uppercase fw-bold">Security & Auth Events</span>
                <h3 class="fw-bold mb-0 mt-1">@Model.SecurityEventsCount</h3>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-success text-white">
                <span class="text-white-50 small text-uppercase fw-bold">Business Data Operations</span>
                <h3 class="fw-bold mb-0 mt-1">@Model.BusinessEventsCount</h3>
            </div>
        </div>
    </div>

    <!-- Table -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-header bg-white py-3 border-0">
            <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-journal-text me-2 text-primary"></i>Audit Log Chronology</h5>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Date & Time (UTC)</th>
                        <th>User</th>
                        <th>Action</th>
                        <th>Entity</th>
                        <th>Record ID</th>
                        <th>Result</th>
                        <th>IP Address</th>
                        <th>Details</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Logs.Any())
                    {
                        foreach (var log in Model.Logs)
                        {
                            <tr>
                                <td class="text-muted small">@log.CreatedDate.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                <td>
                                    <div class="fw-semibold">@log.UserName</div>
                                    <small class="text-muted">@log.UserEmail</small>
                                </td>
                                <td><span class="badge bg-light text-dark border">@log.Action</span></td>
                                <td>@log.EntityName</td>
                                <td>@(log.RecordId ?? "-")</td>
                                <td>
                                    <span class="badge @(log.Result == "Success" ? "bg-success" : "bg-danger")">
                                        @log.Result
                                    </span>
                                </td>
                                <td><code>@(log.IpAddress ?? "-")</code></td>
                                <td class="small text-truncate" style="max-width: 250px;">@(log.Details ?? "-")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">No audit events recorded.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
