@model AcxiomCRM.ViewModels.UserActivityReportViewModel
@{
    ViewData["Title"] = "User & Representative Activity Report";
}

<div class="container-fluid px-0">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="fw-bold text-dark mb-0"><i class="bi bi-people text-secondary me-2"></i>User & Sales Activity Report</h3>
            <span class="text-muted small">Engagement tracking across Calls, Meetings, Emails, and Tasks</span>
        </div>
        <div>
            <button onclick="window.print()" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-printer me-1"></i> Print
            </button>
        </div>
    </div>

    <!-- User Engagement Summary Table -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-header bg-white py-3 border-0">
            <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-person-check me-2 text-primary"></i>Representative Engagement Matrix</h5>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>User Name</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th class="text-center">Calls</th>
                        <th class="text-center">Meetings</th>
                        <th class="text-center">Emails</th>
                        <th class="text-center">Tasks</th>
                        <th class="text-center">Completed</th>
                        <th class="text-center">Total Activities</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model.UserSummaries)
                    {
                        <tr>
                            <td class="fw-bold">@user.UserName</td>
                            <td>@user.Email</td>
                            <td><span class="badge bg-secondary">@user.Role</span></td>
                            <td class="text-center">@user.CallCount</td>
                            <td class="text-center">@user.MeetingCount</td>
                            <td class="text-center">@user.EmailCount</td>
                            <td class="text-center">@user.TaskCount</td>
                            <td class="text-center text-success fw-bold">@user.CompletedCount</td>
                            <td class="text-center fw-bold"><span class="badge bg-primary fs-6">@user.TotalActivities</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Detailed Activity Stream -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-header bg-white py-3 border-0">
            <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-clock-history me-2 text-primary"></i>Recent CRM Activities</h5>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Type</th>
                        <th>Subject</th>
                        <th>Related Entity</th>
                        <th>Date</th>
                        <th>Status</th>
                        <th>Representative</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.DetailedActivities.Any())
                    {
                        foreach (var act in Model.DetailedActivities)
                        {
                            <tr>
                                <td><span class="badge bg-light text-dark border">@act.ActivityType</span></td>
                                <td class="fw-semibold">@act.Subject</td>
                                <td>@act.RelatedTo</td>
                                <td class="text-muted small">@act.ActivityDate.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>
                                    <span class="badge @(act.Status == "Completed" ? "bg-success" : "bg-primary")">
                                        @act.Status
                                    </span>
                                </td>
                                <td>@act.OwnerName</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">No activities logged yet.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
