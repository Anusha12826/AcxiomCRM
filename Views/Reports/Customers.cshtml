@model AcxiomCRM.ViewModels.GenericReportViewModel<AcxiomCRM.ViewModels.CustomerReportItem>
@{
    ViewData["Title"] = "Customer Report";
}

<div class="container-fluid px-0">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="fw-bold text-dark mb-0"><i class="bi bi-building text-primary me-2"></i>Customer Report</h3>
            <span class="text-muted small">Total Records: <strong>@Model.TotalCount</strong></span>
        </div>
        <div>
            <a asp-action="ExportCsv" asp-route-reportType="Customers" 
               asp-route-FromDate="@Model.Filter.FromDate?.ToString("yyyy-MM-dd")"
               asp-route-ToDate="@Model.Filter.ToDate?.ToString("yyyy-MM-dd")"
               asp-route-Status="@Model.Filter.Status"
               asp-route-AssignedTo="@Model.Filter.AssignedTo"
               class="btn btn-outline-success btn-sm me-2">
                <i class="bi bi-file-earmark-spreadsheet me-1"></i> Export CSV
            </a>
            <button onclick="window.print()" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-printer me-1"></i> Print
            </button>
        </div>
    </div>

    <!-- Filter Card -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3">
            <form method="get" asp-action="Customers" class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label class="form-label small text-muted mb-1">From Date</label>
                    <input type="date" name="FromDate" value="@(Model.Filter.FromDate?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small text-muted mb-1">To Date</label>
                    <input type="date" name="ToDate" value="@(Model.Filter.ToDate?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
                </div>
                <div class="col-md-2">
                    <label class="form-label small text-muted mb-1">Status</label>
                    <select name="Status" class="form-select form-select-sm">
                        <option value="">All Statuses</option>
                        <option value="Active" selected="@(Model.Filter.Status == "Active")">Active</option>
                        <option value="Inactive" selected="@(Model.Filter.Status == "Inactive")">Inactive</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small text-muted mb-1">Owner</label>
                    <select name="AssignedTo" class="form-select form-select-sm">
                        <option value="">All Owners</option>
                        @foreach (var user in Model.AvailableUsers)
                        {
                            <option value="@user.Key" selected="@(Model.Filter.AssignedTo == user.Key)">@user.Value</option>
                        }
                    </select>
                </div>
                <div class="col-md-2 d-flex gap-1">
                    <button type="submit" class="btn btn-primary btn-sm flex-grow-1">Filter</button>
                    <a asp-action="Customers" class="btn btn-outline-secondary btn-sm">Reset</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Table -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Code</th>
                        <th>Customer Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Company</th>
                        <th>City</th>
                        <th>Status</th>
                        <th>Account Owner</th>
                        <th>Created Date</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items.Any())
                    {
                        foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="fw-bold">@item.CustomerCode</td>
                                <td>@item.CustomerName</td>
                                <td>@item.Email</td>
                                <td>@item.Phone</td>
                                <td>@(item.CompanyName ?? "-")</td>
                                <td>@(item.City ?? "-")</td>
                                <td>
                                    <span class="badge @(item.Status == "Active" ? "bg-success-subtle text-success border border-success-subtle" : "bg-secondary-subtle text-secondary border border-secondary-subtle")">
                                        @item.Status
                                    </span>
                                </td>
                                <td>@item.OwnerName</td>
                                <td class="text-muted small">@item.CreatedDate.ToString("yyyy-MM-dd HH:mm")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center py-4 text-muted">No customer records matching the filter criteria.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
