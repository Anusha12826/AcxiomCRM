@{
    ViewData["Title"] = "Account Locked Out";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 text-center">
        <div class="card shadow-sm border-warning border-top border-4 rounded-3 p-4">
            <div class="display-1 text-warning mb-3">
                <i class="bi bi-lock-fill"></i>
            </div>
            <h2 class="fw-bold text-dark">Account Temporarily Locked</h2>
            <p class="text-muted mt-2 fs-5">
                This account has been temporarily locked due to multiple consecutive failed sign-in attempts.
            </p>
            <p class="text-secondary small">
                In accordance with AcxiomCRM security policy, your account will remain locked for 15 minutes to protect against unauthorized access. You may also contact an Administrator to unlock your account immediately.
            </p>
            <div class="mt-4">
                <a asp-action="Login" class="btn btn-primary px-4">
                    <i class="bi bi-box-arrow-in-right me-1"></i> Return to Login
                </a>
            </div>
        </div>
    </div>
</div>
