@model AcxiomCRM.ViewModels.DashboardViewModel
@using AcxiomCRM.Models.Constants
@{
    ViewData["Title"] = "CRM Dashboard";
}

<!-- Dashboard Header & Role Scope -->
<div class="row align-items-center mb-4">
    <div class="col-md-7">
        <h2 class="fw-bold mb-1">
            <i class="bi bi-speedometer2 text-primary me-2"></i>Sales Dashboard
        </h2>
        <p class="text-muted mb-0">
            Welcome back, <strong>@Model.UserFullName</strong> &bull;
            @if (Model.UserRole == AppRoles.Admin)
            {
                <span class="badge bg-danger"><i class="bi bi-shield-shaded me-1"></i>Administrator &bull; Organization Scope</span>
            }
            else if (Model.UserRole == AppRoles.Manager)
            {
                <span class="badge bg-primary"><i class="bi bi-people-fill me-1"></i>Sales Manager &bull; Team Pipeline Scope</span>
            }
            else
            {
                <span class="badge bg-info text-dark"><i class="bi bi-person-badge-fill me-1"></i>Sales Executive &bull; Assigned Scope</span>
            }
        </p>
    </div>

    <!-- Date Range Filter Form -->
    <div class="col-md-5 mt-3 mt-md-0">
        <div class="card shadow-sm border-0">
            <div class="card-body p-2">
                <form method="get" asp-controller="Dashboard" asp-action="Index" class="row g-2 align-items-center" id="filterForm">
                    <div class="col-6">
                        <select name="dateFilter" class="form-select form-select-sm" id="dateFilterSelect" onchange="toggleCustomDates()">
                            <option value="All" selected="@(Model.DateFilter == "All")">All Time</option>
                            <option value="Today" selected="@(Model.DateFilter == "Today")">Today</option>
                            <option value="ThisWeek" selected="@(Model.DateFilter == "ThisWeek")">This Week</option>
                            <option value="ThisMonth" selected="@(Model.DateFilter == "ThisMonth")">This Month</option>
                            <option value="Custom" selected="@(Model.DateFilter == "Custom")">Custom Range</option>
                        </select>
                    </div>
                    <div class="col-6 text-end">
                        <button type="submit" class="btn btn-sm btn-primary w-100">
                            <i class="bi bi-funnel me-1"></i> Apply Filter
                        </button>
                    </div>
                    <div class="col-12 @(Model.DateFilter == "Custom" ? "" : "d-none")" id="customDateContainer">
                        <div class="input-group input-group-sm">
                            <input type="date" name="startDate" class="form-control" value="@(Model.StartDate?.ToString("yyyy-MM-dd"))" />
                            <span class="input-group-text">to</span>
                            <input type="date" name="endDate" class="form-control" value="@(Model.EndDate?.ToString("yyyy-MM-dd"))" />
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Mandatory KPI Cards (8 Key Metrics) -->
<div class="row g-3 mb-4">
    <!-- 1. Total Customers -->
    <div class="col-sm-6 col-xl-3">
        <div class="card shadow-sm border-0 h-100 border-start border-primary border-4 rounded-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small text-uppercase fw-bold">Total Customers</span>
                        <h3 class="fw-bold mb-0 text-dark">@Model.TotalCustomers</h3>
                    </div>
                    <div class="bg-primary-subtle text-primary p-3 rounded-circle">
                        <i class="bi bi-building fs-4"></i>
                    </div>
                </div>
                <div class="small text-muted mt-2">
                    <i class="bi bi-check-circle text-success me-1"></i> Active customer accounts
                </div>
            </div>
        </div>
    </div>

    <!-- 2. Total Leads -->
    <div class="col-sm-6 col-xl-3">
        <div class="card shadow-sm border-0 h-100 border-start border-info border-4 rounded-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small text-uppercase fw-bold">Total Leads</span>
                        <h3 class="fw-bold mb-0 text-dark">@Model.TotalLeads</h3>
                    </div>
                    <div class="bg-info-subtle text-info p-3 rounded-circle">
                        <i class="bi bi-funnel fs-4"></i>
                    </div>
                </div>
                <div class="small text-muted mt-2">
                    <span>Inquiries captured</span>
                </div>
            </div>
        </div>
    </div>

    <!-- 3. Open Leads -->
    <div class="col-sm-6 col-xl-3">
        <div class="card shadow-sm border-0 h-100 border-start border-warning border-4 rounded-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small text-uppercase fw-bold">Open Leads</span>
                        <h3 class="fw-bold mb-0 text-dark">@Model.OpenLeads</h3>
                    </div>
                    <div class="bg-warning-subtle text-warning p-3 rounded-circle">
                        <i class="bi bi-hourglass-split fs-4"></i>
                    </div>
                </div>
                <div class="small text-muted mt-2">
                    <span class="text-warning fw-semibold">Active & in progress</span>
                </div>
            </div>
        </div>
    </div>

    <!-- 4. Total Opportunities -->
    <div class="col-sm-6 col-xl-3">
        <div class="card shadow-sm border-0 h-100 border-start border-secondary border-4 rounded-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small text-uppercase fw-bold">Total Opportunities</span>
                        <h3 class="fw-bold mb-0 text-dark">@Model.TotalOpportunities</h3>
                    </div>
                    <div class="bg-secondary-subtle text-secondary p-3 rounded-circle">
                        <i class="bi bi-briefcase fs-4"></i>
                    </div>
                </div>
                <div class="small text-muted mt-2">
                    <span>All pipeline deals</span>
                </div>
            </div>
        </div>
    </div>

    <!-- 5. Open Opportunities -->
    <div class="col-sm-6 col-xl-3">
        <div class="card shadow-sm border-0 h-100 border-start border-primary border-4 rounded-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small text-uppercase fw-bold">Open Opportunities</span>
                        <h3 class="fw-bold mb-0 text-dark">@Model.OpenOpportunities</h3>
                    </div>
                    <div class="bg-primary-subtle text-primary p-3 rounded-circle">
                        <i class="bi bi-arrow-repeat fs-4"></i>
                    </div>
                </div>
                <div class="small text-muted mt-2">
                    <span>Negotiation & proposals</span>
                </div>
            </div>
        </div>
    </div>

    <!-- 6. Won Opportunities -->
    <div class="col-sm-6 col-xl-3">
        <div class="card shadow-sm border-0 h-100 border-start border-success border-4 rounded-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small text-uppercase fw-bold">Won Deals</span>
                        <h3 class="fw-bold mb-0 text-success">@Model.WonOpportunities</h3>
                    </div>
                    <div class="bg-success-subtle text-success p-3 rounded-circle">
                        <i class="bi bi-trophy fs-4"></i>
                    </div>
                </div>
                <div class="small text-muted mt-2">
                    <span class="text-success fw-semibold">Successfully closed</span>
                </div>
            </div>
        </div>
    </div>

    <!-- 7. Lost Opportunities -->
    <div class="col-sm-6 col-xl-3">
        <div class="card shadow-sm border-0 h-100 border-start border-danger border-4 rounded-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small text-uppercase fw-bold">Lost Deals</span>
                        <h3 class="fw-bold mb-0 text-danger">@Model.LostOpportunities</h3>
                    </div>
                    <div class="bg-danger-subtle text-danger p-3 rounded-circle">
                        <i class="bi bi-x-circle fs-4"></i>
                    </div>
                </div>
                <div class="small text-muted mt-2">
                    <span>Closed un-won</span>
                </div>
            </div>
        </div>
    </div>

    <!-- 8. Total Pipeline Value -->
    <div class="col-sm-6 col-xl-3">
        <div class="card shadow-sm border-0 h-100 border-start border-success border-4 rounded-3 bg-dark text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-white-50 small text-uppercase fw-bold">Pipeline Value</span>
                        <h4 class="fw-bold mb-0 text-success">₹@Model.TotalPipelineValue.ToString("N0")</h4>
                    </div>
                    <div class="bg-success text-white p-3 rounded-circle">
                        <i class="bi bi-currency-rupee fs-4"></i>
                    </div>
                </div>
                <div class="small text-white-50 mt-2">
                    Weighted: <strong class="text-white">₹@Model.WeightedPipelineValue.ToString("N0")</strong>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Charts Row (Chart.js Real DB Visualizations) -->
<div class="row g-3 mb-4">
    <!-- Chart 1: Lead Status Chart -->
    <div class="col-lg-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white py-3 border-0">
                <h6 class="fw-bold mb-0"><i class="bi bi-pie-chart text-primary me-2"></i>Lead Status Breakdown</h6>
                <small class="text-muted">New, Contacted, Qualified, Lost, Converted</small>
            </div>
            <div class="card-body d-flex justify-content-center align-items-center" style="position: relative; height: 260px;">
                <canvas id="leadStatusChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Chart 2: Opportunity Pipeline Stage Chart -->
    <div class="col-lg-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white py-3 border-0">
                <h6 class="fw-bold mb-0"><i class="bi bi-bar-chart-steps text-warning me-2"></i>Pipeline by Stage</h6>
                <small class="text-muted">Total value across deal stages</small>
            </div>
            <div class="card-body" style="position: relative; height: 260px;">
                <canvas id="pipelineStageChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Chart 3: Monthly Sales & Pipeline Trend -->
    <div class="col-lg-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white py-3 border-0">
                <h6 class="fw-bold mb-0"><i class="bi bi-graph-up text-success me-2"></i>Monthly Sales Trend</h6>
                <small class="text-muted">Won revenue vs open pipeline</small>
            </div>
            <div class="card-body" style="position: relative; height: 260px;">
                <canvas id="monthlySalesChart"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Operational Section: Upcoming Follow-Ups & Recent Activities -->
<div class="row g-3">
    <!-- Upcoming & Pending Follow-Ups -->
    <div class="col-lg-6">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-0">
                <div>
                    <h6 class="fw-bold mb-0"><i class="bi bi-calendar-check text-info me-2"></i>Upcoming Follow-Ups</h6>
                    <small class="text-muted">Pending: <strong>@Model.PendingFollowUpsCount</strong> &bull; Overdue: <strong class="text-danger">@Model.OverdueFollowUpsCount</strong></small>
                </div>
                <a asp-controller="FollowUps" asp-action="Index" class="btn btn-sm btn-outline-info">View All</a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light small">
                            <tr>
                                <th>Date</th>
                                <th>Type</th>
                                <th>Related To</th>
                                <th>Remarks</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody class="small">
                            @if (!Model.UpcomingFollowUps.Any())
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-4 text-muted">
                                        No planned follow-ups scheduled.
                                    </td>
                                </tr>
                            }
                            @foreach (var fu in Model.UpcomingFollowUps)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-semibold">@fu.FollowUpDate.ToString("MMM dd, yyyy")</div>
                                        <div class="text-muted smaller">@fu.FollowUpDate.ToString("hh:mm tt")</div>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">@fu.FollowUpType</span>
                                    </td>
                                    <td>
                                        @(fu.Customer?.CustomerName ?? fu.Lead?.LeadName ?? "N/A")
                                    </td>
                                    <td>
                                        <span class="text-truncate d-inline-block" style="max-width: 150px;" title="@fu.Remarks">
                                            @(fu.Remarks ?? "-")
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge bg-primary">@fu.Status</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Activities -->
    <div class="col-lg-6">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-0">
                <div>
                    <h6 class="fw-bold mb-0"><i class="bi bi-clock-history text-secondary me-2"></i>Recent CRM Activities</h6>
                    <small class="text-muted">Calls, meetings, emails and tasks</small>
                </div>
                <a asp-controller="Activities" asp-action="Index" class="btn btn-sm btn-outline-secondary">View All</a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light small">
                            <tr>
                                <th>Activity</th>
                                <th>Subject</th>
                                <th>Related</th>
                                <th>Date</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody class="small">
                            @if (!Model.RecentActivities.Any())
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-4 text-muted">
                                        No recent activities recorded.
                                    </td>
                                </tr>
                            }
                            @foreach (var act in Model.RecentActivities)
                            {
                                <tr>
                                    <td>
                                        @switch (act.ActivityType)
                                        {
                                            case "Call":
                                                <span class="badge bg-info-subtle text-info"><i class="bi bi-telephone me-1"></i>Call</span>
                                                break;
                                            case "Meeting":
                                                <span class="badge bg-primary-subtle text-primary"><i class="bi bi-people me-1"></i>Meeting</span>
                                                break;
                                            case "Email":
                                                <span class="badge bg-warning-subtle text-warning"><i class="bi bi-envelope me-1"></i>Email</span>
                                                break;
                                            default:
                                                <span class="badge bg-secondary-subtle text-secondary"><i class="bi bi-check2-square me-1"></i>Task</span>
                                                break;
                                        }
                                    </td>
                                    <td class="fw-semibold">@act.Subject</td>
                                    <td>@(act.Customer?.CustomerName ?? act.Lead?.LeadName ?? "N/A")</td>
                                    <td class="text-muted">@act.ActivityDate.ToString("MMM dd, yyyy")</td>
                                    <td><span class="badge bg-success">@act.Status</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Chart.js Library -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.6/dist/chart.umd.min.js"></script>

    <script>
        function toggleCustomDates() {
            var val = document.getElementById('dateFilterSelect').value;
            var container = document.getElementById('customDateContainer');
            if (val === 'Custom') {
                container.classList.remove('d-none');
            } else {
                container.classList.add('d-none');
            }
        }

        document.addEventListener('DOMContentLoaded', function () {
            // 1. Lead Status Doughnut Chart
            var leadLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LeadStatusLabels));
            var leadCounts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LeadStatusCounts));

            new Chart(document.getElementById('leadStatusChart'), {
                type: 'doughnut',
                data: {
                    labels: leadLabels,
                    datasets: [{
                        data: leadCounts,
                        backgroundColor: ['#0d6efd', '#0dcaf0', '#198754', '#dc3545', '#6f42c1'],
                        borderWidth: 2
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'bottom', labels: { boxWidth: 12, font: { size: 11 } } }
                    }
                }
            });

            // 2. Opportunity Pipeline Bar Chart
            var pipeLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PipelineStageLabels));
            var pipeAmounts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PipelineStageAmounts));

            new Chart(document.getElementById('pipelineStageChart'), {
                type: 'bar',
                data: {
                    labels: pipeLabels,
                    datasets: [{
                        label: 'Value (₹)',
                        data: pipeAmounts,
                        backgroundColor: ['#6c757d', '#ffc107', '#fd7e14', '#198754', '#dc3545'],
                        borderRadius: 4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                callback: function(value) { return '₹' + value.toLocaleString(); }
                            }
                        }
                    },
                    plugins: { legend: { display: false } }
                }
            });

            // 3. Monthly Sales Trend Chart
            var monthLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlySalesLabels));
            var monthWon = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlySalesWon));
            var monthPipe = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlySalesPipeline));

            new Chart(document.getElementById('monthlySalesChart'), {
                type: 'line',
                data: {
                    labels: monthLabels,
                    datasets: [
                        {
                            label: 'Won (₹)',
                            data: monthWon,
                            borderColor: '#198754',
                            backgroundColor: 'rgba(25, 135, 84, 0.1)',
                            fill: true,
                            tension: 0.3
                        },
                        {
                            label: 'Pipeline (₹)',
                            data: monthPipe,
                            borderColor: '#0d6efd',
                            backgroundColor: 'transparent',
                            borderDash: [5, 5],
                            tension: 0.3
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                callback: function(value) { return '₹' + value.toLocaleString(); }
                            }
                        }
                    },
                    plugins: {
                        legend: { position: 'bottom', labels: { boxWidth: 12, font: { size: 11 } } }
                    }
                }
            });
        });
    </script>
}
